# Copy this file to .env (same folder) and fill in the values. Never commit .env.
# Supabase dashboard -> Project Settings -> API Keys / Data API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key: server-only, bypasses Row Level Security. Never put this in the mobile app.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Comma-separated origins allowed to call the API (only matters for Expo web).
CORS_ORIGINS=http://localhost:8081
