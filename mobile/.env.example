# Copy this file to .env (same folder) and fill in the values.
# Supabase dashboard -> Project Settings -> API Keys / Data API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# FastAPI backend. On a real phone use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
